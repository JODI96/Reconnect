<Project>
  <!-- Zentrale Paketverwaltung: Versionen nur hier pflegen, in den .csproj ohne Version referenzieren. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.5.4" />
