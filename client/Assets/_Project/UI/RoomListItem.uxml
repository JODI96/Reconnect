<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="room-item">
        <ui:VisualElement class="room-item__text" style="flex-shrink: 1; min-width: 0;">
            <ui:Label name="name" class="room-item__name ellipsis" />
            <ui:Label name="owner" class="room-item__owner ellipsis" />
        </ui:VisualElement>
        <ui:Label name="visibility" class="room-item__badge" />
    </ui:VisualElement>
</ui:UXML>
