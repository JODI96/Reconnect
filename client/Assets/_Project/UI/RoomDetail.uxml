<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="toolbar">
        <ui:Button name="back" text="‹ Zurück" class="button button--small" style="margin-left: 0;" />
    </ui:VisualElement>
    <ui:VisualElement class="centered form">
        <ui:Label name="name" class="title" />
        <ui:Label name="owner" class="subtitle" />
        <ui:Label name="details" class="muted" style="-unity-text-align: middle-center; white-space: normal; margin-bottom: 32px;" />
        <ui:Label name="status" class="status" />
        <ui:Button name="enter" text="Betreten (kommt in Phase 3)" class="button button--primary" />
    </ui:VisualElement>
</ui:UXML>
