<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Elements with class "pass-through" don't catch touches, so the floor below can be tapped. -->
    <ui:VisualElement name="labels" class="city-labels pass-through" />
    <ui:VisualElement class="city-layout pass-through">
        <ui:VisualElement class="toolbar toolbar--floating">
            <ui:VisualElement class="pass-through" style="flex-grow: 1; flex-shrink: 1; min-width: 0;">
                <ui:Label name="room-name" text="Raum" class="heading heading--on-map ellipsis pass-through" />
                <ui:Label name="room-owner" class="muted ellipsis pass-through" />
            </ui:VisualElement>
            <ui:Button name="lift" text="Lift" class="button button--small" style="display: none;" />
            <ui:Button name="build" text="Bauen" class="button button--small" style="display: none;" />
            <ui:Button name="music" text="Ton" class="button button--small" />
            <ui:Button name="leave" text="Verlassen" class="button button--small" />
        </ui:VisualElement>
        <ui:Label name="status" class="status status--floating" />
        <!-- Waiting in the lift queue for a full floor. -->
        <ui:VisualElement name="queue-banner" class="queue-banner" style="display: none;">
            <ui:Label name="queue-text" class="queue-banner__text" />
            <ui:Button name="queue-leave" text="Aussteigen" class="button button--small" />
        </ui:VisualElement>
        <ui:VisualElement class="pass-through" style="flex-grow: 1;" />

        <!-- Lift panel: opened by tapping the lift bank or the "Lift" button. -->
        <ui:VisualElement name="lift-panel" class="game-panel lift-panel" style="display: none;">
            <ui:VisualElement class="sheet__header">
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:Label name="lift-title" text="Lift" class="sheet__title" />
                    <ui:Label name="lift-subtitle" class="muted" />
                </ui:VisualElement>
                <ui:Button name="lift-close" text="×" class="button button--small" />
            </ui:VisualElement>
            <ui:ScrollView name="lift-floors" class="lift-floors" />
            <ui:Label name="lift-status" class="status" />
        </ui:VisualElement>

        <!-- Minigames: opened by tapping the tic-tac-toe table or the quiz TV. -->
        <ui:VisualElement name="game-panel" class="game-panel" style="display: none;">
            <ui:VisualElement class="sheet__header">
                <ui:Label name="game-title" class="sheet__title" style="flex-grow: 1;" />
                <ui:Button name="game-close" text="×" class="button button--small" />
            </ui:VisualElement>

            <ui:VisualElement name="ttt-panel">
                <ui:Label name="ttt-status" class="status" />
                <ui:VisualElement class="ttt-grid">
                    <ui:VisualElement class="ttt-row">
                        <ui:Button name="cell-0" class="ttt-cell" /><ui:Button name="cell-1" class="ttt-cell" /><ui:Button name="cell-2" class="ttt-cell" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ttt-row">
                        <ui:Button name="cell-3" class="ttt-cell" /><ui:Button name="cell-4" class="ttt-cell" /><ui:Button name="cell-5" class="ttt-cell" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ttt-row">
                        <ui:Button name="cell-6" class="ttt-cell" /><ui:Button name="cell-7" class="ttt-cell" /><ui:Button name="cell-8" class="ttt-cell" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="button-row">
                    <ui:Button name="ttt-join" text="Mitspielen" class="button button--primary" />
                    <ui:Button name="ttt-reset" text="Neues Spiel" class="button" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="quiz-panel">
                <ui:Label name="quiz-question" class="quiz-question" />
                <ui:Button name="answer-0" class="button quiz-answer" />
                <ui:Button name="answer-1" class="button quiz-answer" />
                <ui:Button name="answer-2" class="button quiz-answer" />
                <ui:Button name="answer-3" class="button quiz-answer" />
                <ui:Label name="quiz-status" class="status" />
                <ui:VisualElement class="button-row">
                    <ui:Button name="quiz-start" text="Quiz starten" class="button button--primary" />
                    <ui:Button name="quiz-next" text="Weiter" class="button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Build editor (owner or admin): item in hand, catalog, save. -->
        <ui:VisualElement name="build-panel" class="build-panel" style="display: none;">
            <ui:Label name="build-hint" class="build-hint" />
            <ui:VisualElement name="build-actions" class="build-actions">
                <ui:Button name="build-rotate" text="Drehen" class="button button--small" />
                <ui:Button name="build-delete" text="Entfernen" class="button button--small" />
                <ui:Button name="build-cancel" text="Zurück" class="button button--small" />
                <ui:Button name="build-place" text="Setzen" class="button button--primary button--small" />
            </ui:VisualElement>
            <ui:ScrollView name="build-categories" mode="Horizontal" class="build-categories" />
            <ui:ScrollView name="build-items" mode="Horizontal" class="build-items" />
            <ui:VisualElement class="build-footer">
                <ui:Button name="build-undo" text="Rückgängig" class="button button--small" />
                <ui:VisualElement class="pass-through" style="flex-grow: 1;" />
                <ui:Button name="build-discard" text="Verwerfen" class="button button--small" />
                <ui:Button name="build-save" text="Speichern" class="button button--primary button--small" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="emote-bar" class="emote-bar">
            <ui:Button name="view-left" text="‹" tooltip="Ansicht drehen" class="button button--small emote view-turn" />
            <ui:Button name="view-right" text="›" tooltip="Ansicht drehen" class="button button--small emote view-turn" />
            <ui:Button name="emote-wave" text="Winken" class="button button--small emote" />
            <ui:Button name="emote-yes" text="Ja" class="button button--small emote" />
            <ui:Button name="emote-no" text="Nein" class="button button--small emote" />
            <ui:Button name="emote-jump" text="Hüpfen" class="button button--small emote" />
        </ui:VisualElement>
        <ui:Label name="tower-credit" text="Gebäudeumriss © OpenStreetMap-Mitwirkende · Unabhängiges Spiel, nicht verbunden mit den Eigentümern des Gebäudes" class="attribution pass-through" style="display: none; align-self: flex-end;" />
        <ui:VisualElement name="chat-bar" class="chat-bar">
            <ui:TextField name="chat-input" class="field chat-bar__input" />
            <ui:Button name="send" text="Senden" class="button button--primary button--small" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Lift ride: doors close, the floor indicator counts, the new floor is built behind the doors. -->
    <ui:VisualElement name="lift-ride" class="lift-ride" picking-mode="Ignore" style="display: none;">
        <ui:VisualElement name="lift-door-left" class="lift-door lift-door--left" picking-mode="Ignore" />
        <ui:VisualElement name="lift-door-right" class="lift-door lift-door--right" picking-mode="Ignore" />
        <ui:VisualElement name="lift-display" class="lift-display" picking-mode="Ignore">
            <ui:Label name="lift-arrow" class="lift-display__arrow" picking-mode="Ignore" />
            <ui:Label name="lift-floor" class="lift-display__floor" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
