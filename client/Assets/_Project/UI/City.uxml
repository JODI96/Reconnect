<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Elements with class "pass-through" don't catch touches, so the map below can be dragged. -->
    <ui:VisualElement name="labels" class="city-labels pass-through" />
    <ui:VisualElement class="city-layout pass-through">
        <ui:VisualElement class="toolbar toolbar--floating">
            <ui:Label text="Zürich" class="heading heading--on-map ellipsis pass-through" />
            <ui:Label name="balance" class="balance-chip pass-through" />
            <ui:Button name="menu" text="Menü" class="button button--small" />
        </ui:VisualElement>
        <ui:VisualElement name="menu-panel" class="menu-panel" style="display: none;">
            <ui:Button name="rooms" text="Alle Räume" class="button" />
            <ui:Button name="layer" text="Karte" class="button" />
            <ui:Button name="logout" text="Abmelden" class="button" />
        </ui:VisualElement>
        <ui:Label name="status" class="status status--floating" />
        <ui:VisualElement class="pass-through" style="flex-grow: 1;" />

        <ui:VisualElement name="sheet" class="sheet">
            <ui:VisualElement class="sheet__header">
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:Label name="sheet-title" class="sheet__title" style="white-space: normal;" />
                    <ui:Label name="sheet-address" class="muted" />
                </ui:VisualElement>
                <ui:Button name="sheet-close" text="×" class="button button--small" />
            </ui:VisualElement>
            <ui:Label name="sheet-status" class="status" />
            <!-- Towers (Prime Tower): enter through the lobby, buy an office. -->
            <ui:VisualElement name="tower-actions" class="sheet__actions" style="display: none;">
                <ui:Button name="tower-enter" class="button button--primary" />
                <ui:Button name="tower-offices" text="Büros kaufen" class="button" />
                <ui:Label text="Unabhängiges Spiel – nicht verbunden mit den Eigentümern oder Betreibern dieses Gebäudes. Der Name dient nur der Ortsangabe." class="disclaimer" />
            </ui:VisualElement>
            <ui:ScrollView name="sheet-scroll" class="sheet__rooms">
                <ui:VisualElement name="sheet-rooms" />
            </ui:ScrollView>
            <ui:VisualElement class="sheet__create">
                <ui:TextField name="new-room-name" max-length="80" class="field sheet__input" />
                <ui:Button name="create-room" text="+ Raum erstellen" class="button button--primary button--small" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="city-footer pass-through">
            <ui:Label name="tile-status" class="attribution pass-through" />
            <ui:Label name="map-hint" class="attribution map-hint pass-through" />
            <ui:Label name="attribution" text="© swisstopo" class="attribution pass-through" />
            <ui:Label text="Gebäudeumrisse © OpenStreetMap-Mitwirkende" class="attribution pass-through" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
